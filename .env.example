# Copy to .env and fill in. Never commit .env.

# Google Cloud API key with YouTube Data API v3 enabled (free, 10k units/day).
# Optional: without it, ingestion falls back to yt-dlp (slower, keyless).
YOUTUBE_API_KEY=

# SQLite database file
DATABASE_PATH=organizer.db

# Browser to read cookies from: firefox | chrome | edge | brave | ...
# Needed for private playlists (Watch Later) AND for downloads above 360p --
# without it YouTube serves only the progressive stream. Takes an optional
# profile path after a colon, which is how Firefox forks (Zen, LibreWolf) are
# reached, since yt-dlp only knows a fixed list of browser names:
#   YTDLP_COOKIES_BROWSER=firefox:C:\Users\you\AppData\Roaming\zen\Profiles\xxxx.Default (release)
YTDLP_COOKIES_BROWSER=

# yt-dlp player client for downloads, comma-separated. Blank = yt-dlp's default.
# YouTube gates the default client's streams behind a proof-of-origin token: the
# metadata resolves but the download 403s. Two ways out — set
# YTDLP_COOKIES_BROWSER above (keeps full quality), or put "android" here, which
# needs no cookies but is usually only offered 360p.
YTDLP_PLAYER_CLIENT=

# Where downloaded videos are stored (one file per video id)
MEDIA_PATH=media

# Where the log file goes. Rotates at 2 MB, keeps 5 files. The desktop window
# has no console, so this is the only place errors are recorded.
LOG_PATH=logs

# Default download quality ceiling: 2160 = 4K, 1440 = 2K, 1080, 720, 480, 360.
# Anything above 360 needs ffmpeg on PATH — YouTube splits audio off taller
# streams, and ffmpeg is what puts them back together. On Windows:
#   winget install Gyan.FFmpeg
DOWNLOAD_MAX_HEIGHT=1440
