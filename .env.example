# Copy to .env and fill in. Never commit .env.

# Google Cloud API key with YouTube Data API v3 enabled (free, 10k units/day).
# Optional: without it, ingestion falls back to yt-dlp (slower, keyless).
YOUTUBE_API_KEY=

# SQLite database file
DATABASE_PATH=organizer.db

# Browser to read cookies from for private playlists (Watch Later): firefox | chrome | edge
YTDLP_COOKIES_BROWSER=

# Where downloaded videos are stored (one file per video id)
MEDIA_PATH=media

# Where the log file goes. Rotates at 2 MB, keeps 5 files. The desktop window
# has no console, so this is the only place errors are recorded.
LOG_PATH=logs

# Default download quality ceiling: 2160 = 4K, 1440 = 2K, 1080, 720, 480, 360.
# Anything above 360 needs ffmpeg on PATH — YouTube splits audio off taller
# streams, and ffmpeg is what puts them back together. On Windows:
#   winget install Gyan.FFmpeg
DOWNLOAD_MAX_HEIGHT=1440
